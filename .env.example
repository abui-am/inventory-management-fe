# Kelima URL ini adalah prefix route pada satu aplikasi Laravel yang sama,
# bukan lima service terpisah. Produksi: https://api.tokoputrapribumi.com/api/v1/...
NEXT_PUBLIC_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_GENERAL_URL=http://localhost:8000/api/v1/general
NEXT_PUBLIC_SUPERADMIN_URL=http://localhost:8000/api/v1/superadmin
NEXT_PUBLIC_ADMIN_URL=http://localhost:8000/api/v1/admin
NEXT_PUBLIC_WAREHOUSE_URL=http://localhost:8000/api/v1/warehouse-admin

# Error tracking. Kosong = SDK mati total, aplikasi tetap jalan.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Hanya untuk build di CI/Vercel: mengaktifkan upload source map supaya stack
# trace di Sentry tidak minified. Rahasia, jangan pakai prefix NEXT_PUBLIC_.
SENTRY_AUTH_TOKEN=
